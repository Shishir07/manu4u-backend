# Copy to .env (git-ignored) and fill in. Never commit real values.
# docker compose reads .env automatically; for the app run:  set -a; source .env; set +a

# --- external services ---
API_FOOTBALL_KEY=your_api_football_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- local infrastructure (docker-compose.yml) ---
POSTGRES_PASSWORD=choose_a_local_password
DB_PASSWORD=choose_a_local_password        # must match POSTGRES_PASSWORD

# --- API access ---
# Shared key the frontend sends as the X-Api-Key header on /ask and /ask/stream
MANU4U_GUEST_API_KEY=choose_a_long_random_string
